<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GraphShield · Agent Context Layer on HydraDB · V9</title><style>
:root{color-scheme:dark;--bg:#080e19;--side:#0c1423;--panel:#111d2c;--p2:#142335;--line:#26394c;--text:#e9f3fc;--muted:#93a8bb;--mint:#40d1be;--blue:#7aaee7;--red:#ff9b9e;--amber:#e4b56b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 'Segoe UI',Inter,Arial,sans-serif}button,input,select{font:inherit}button{cursor:pointer;background:#1c2e44;color:var(--text);border:1px solid #395067;padding:10px 14px;border-radius:9px;font-weight:650}button:hover{border-color:var(--mint)}button:disabled{opacity:.5;cursor:default}button.primary{background:var(--mint);color:#03272b;border-color:var(--mint)}button.outline{background:transparent}button.danger{background:#4b2532;color:#ffb9bc;border-color:#78434e}button.small{padding:6px 9px;font-size:11px}input,select{background:#0b1828;color:var(--text);border:1px solid #365069;border-radius:9px;padding:11px 12px;min-width:0}input:focus,select:focus{outline:1px solid var(--mint)}h1,h2,h3,p{margin:0}h1{font-size:28px;letter-spacing:-.6px}h2{font-size:18px;letter-spacing:-.2px}h3{font-size:14px}.muted{color:var(--muted)}.small{font-size:12px}.tiny{font-size:11px}.mono,pre{font:12px/1.5 Consolas,monospace}pre{white-space:pre-wrap;word-break:break-word;background:#091423;padding:12px;border:1px solid var(--line);border-radius:9px;max-height:280px;overflow:auto}.layout{display:grid;grid-template-columns:232px minmax(0,1fr);min-height:100vh}.sidebar{padding:27px 17px;background:var(--side);border-right:1px solid var(--line);position:sticky;top:0;height:100vh}.logo{font-size:23px;font-weight:850;letter-spacing:-1px;margin-bottom:7px}.logo em{font-style:normal;color:var(--mint)}.rail-label{font-size:10px;color:#728ca4;letter-spacing:2px;text-transform:uppercase;font-weight:750;margin:31px 12px 10px}.nav{display:grid;gap:5px}.nav button{width:100%;text-align:left;border:0;background:transparent;font-size:13px;color:#9fb3c7;padding:13px}.nav button.active{background:#1a3441;color:var(--mint);border-left:3px solid var(--mint)}.side-footer{position:absolute;bottom:22px;left:18px;right:18px;color:#839cb1;font-size:11px}.main{max-width:1550px;width:100%;margin:auto;padding:24px 34px 55px}.topbar{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:22px;gap:15px}.topbar .crumb{font-size:12px;color:var(--muted)}.badge{display:inline-flex;gap:6px;align-items:center;color:var(--mint);border:1px solid #296c66;background:#12332f;border-radius:30px;padding:6px 11px;font-size:11px}.badge.bad{color:var(--red);background:#37222b;border-color:#7e3e4c}.eyebrow{color:var(--mint);font-size:11px;letter-spacing:2px;font-weight:800;margin:26px 0 7px}.intro{color:var(--muted);max-width:790px;margin-top:9px}.view{display:none}.view.active{display:block}.columns{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(290px,.8fr);gap:18px;margin-top:22px}.columns.equal{grid-template-columns:1fr 1fr}.panel{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:22px;min-width:0;margin-bottom:17px}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:15px}.panel p{margin:10px 0}.flex{display:flex;align-items:center;gap:10px}.grow{flex:1}.stack{display:grid;gap:10px}.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-top:18px}.kpi{background:#0b1828;border:1px solid #24374a;border-radius:11px;padding:16px}.kpi .number{font-size:26px;font-weight:850;letter-spacing:-.6px;margin:6px 0}.status{border-left:3px solid var(--mint);background:#102b31;padding:10px 13px;border-radius:7px;margin-top:13px;color:#a3eadf;white-space:pre-wrap}.status.bad{border-color:var(--red);background:#35212c;color:#ffbec2}.chips{display:flex;flex-wrap:wrap;gap:8px;margin:13px 0 18px}.chip{padding:7px 11px;font-size:12px;border:1px solid #38566a;border-radius:20px;background:#183146;color:#d1e5f0}.mode-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:15px 0}.mode-card{background:#0c1b2d;border:1px solid #2e455c;text-align:left;padding:13px}.mode-card.selected{border-color:var(--mint);background:#15343a}.mode-card strong{display:block;font-size:13px;margin-bottom:3px}.mode-card span{font-size:11px;color:var(--muted)}.steps{display:grid;gap:8px;margin-top:13px}.step{display:flex;align-items:start;justify-content:space-between;gap:12px;border:1px solid #2b455c;border-radius:9px;background:#0d1d2e;padding:12px}.step-index{background:#1b4b4a;border:1px solid #34847d;border-radius:50%;width:26px;height:26px;display:grid;place-items:center;font-size:12px;color:#9bf9e8;flex-shrink:0}.step-main{flex:1;min-width:0}.step-main strong{display:block}.context-track{height:12px;background:#2b3f53;border-radius:20px;overflow:hidden;margin:16px 0}.context-track div{height:100%;background:var(--mint);transition:width .3s}.context-values{display:flex;justify-content:space-between;gap:15px}.context-values strong{font-size:23px}.metric-row{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:10px 0;gap:10px}.metric-row:last-child{border:0}.disclosure{padding:12px;background:#122236;border:1px solid #395067;border-radius:9px;color:#a4bcd2;font-size:12px;margin-top:14px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:10px 9px;border-bottom:1px solid #2a3d4e;text-align:left;vertical-align:top}th{color:#9fb6c9;font-size:11px}svg{max-width:100%}svg text{font:11px 'Segoe UI',Arial,sans-serif}.empty{border:1px dashed #3a5066;border-radius:10px;padding:25px;color:var(--muted);text-align:center}.event{border-left:2px solid #547c91;padding:7px 11px;margin:6px 0;background:#0d1a2a}.event.failed{border-color:var(--red)}.event.result,.event.done{border-color:var(--mint)}.section-note{font-size:12px;color:var(--muted);margin:8px 0 18px}.search-box{display:flex;gap:8px}.search-box input{flex:1}.scroll{max-height:400px;overflow:auto}.tool-row{padding:12px;border-bottom:1px solid var(--line)}.tool-row:hover{background:#1b2d42}.tool-row strong{display:block}.hidden{display:none!important}.progress{border-radius:20px;background:#2b3e55;height:9px;overflow:hidden}.progress>div{height:100%;background:var(--mint);width:0;transition:width .3s}.legend{display:flex;gap:15px;flex-wrap:wrap;color:#a1b9cb;font-size:11px}.legend i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;background:var(--mint)}.legend i.blue{background:var(--blue)}.legend i.gray{background:#7c8fa6}.footer{border-top:1px solid var(--line);padding-top:22px;margin-top:32px;color:#829bb0;font-size:12px}@media(max-width:1100px){.layout{grid-template-columns:1fr}.sidebar{height:auto;position:static;padding:14px}.side-footer,.rail-label{display:none}.sidebar .nav{display:flex;overflow:auto}.sidebar .nav button{white-space:nowrap}.main{padding:18px}.columns,.columns.equal{grid-template-columns:1fr}}@media(max-width:700px){.mode-grid,.kpis{grid-template-columns:1fr}.flex,.search-box{flex-wrap:wrap}.main{padding:14px}.context-values{flex-direction:column}}
.desk-event{padding:12px;border:1px solid var(--line);background:#0b1928;border-radius:9px;margin:8px 0;display:grid;gap:5px}.desk-event.bad{border-color:#a84f59}.desk-node{border:1px solid #2b9e92;background:#0d3131;color:#e3fff9;border-radius:9px;padding:12px;margin:4px 0;display:grid;gap:3px}.desk-node span{font-size:11px;color:#a2cbc7}.desk-node.task{border-color:#7aaee7;text-align:center;background:#152c44}.desk-flow{text-align:center;color:#8cb9b8;font-size:10px;letter-spacing:1px;padding:6px}.desk-trace{max-height:650px;overflow:auto}.desk-event summary{cursor:pointer} 
:root{--bg:#080e17;--side:#0e1724;--panel:#111f2e;--p2:#162637;--line:#2c4050;--mint:#47d5b8}
body{font-family:Inter,'Segoe UI',Arial,sans-serif;background:radial-gradient(circle at 75% -200px,#193246 0,transparent 45%),var(--bg)}
.main{max-width:1720px}.sidebar{padding:30px 18px}.hero{padding:9px 0 24px}.hero h1{font-size:36px;line-height:1.15;max-width:800px}.hero .intro{max-width:800px;margin-top:12px}.eyebrow{letter-spacing:.16em}.panel{box-shadow:0 5px 30px rgba(0,0,0,.08)}
.case-card{border:1px solid #406277;background:linear-gradient(140deg,#172b39,#11212f);padding:24px;border-radius:15px;margin:14px 0 24px}.case-kicker{color:#62ddc1;letter-spacing:.12em;font-weight:750;font-size:11px;text-transform:uppercase}
.case-message{font-size:23px;font-weight:620;letter-spacing:-.3px;margin:12px 0 18px;max-width:860px}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(330px,.85fr);gap:18px}.dashboard-grid>div{min-width:0}.dashboard-grid .panel{margin-bottom:18px}
.sidebar button[data-jump]{width:100%;text-align:left;display:block;margin-top:8px}.sidebar button[data-jump].active{background:#1c3a42;color:#67e5d2;border-left:3px solid var(--mint)}
.build-tag{color:#d8edeb;background:#16443f;border:1px solid #38776e;border-radius:40px;padding:6px 11px;font-size:11px;font-weight:750}
.panel h2{font-size:17px}.panel-head{align-items:center}.panel pre{font-size:11px}.metric-row{gap:16px}.tiny{letter-spacing:.01em}.status.bad{background:#40232c}.sequence{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}.sequence span{font-size:12px;border:1px solid #31535b;border-radius:40px;padding:6px 12px;color:#a9d4d1}.sidebar-hint{font-size:11px;color:#91abb9;line-height:1.6;margin-top:22px}.footer-note{font-size:11px;color:#91a8b7;border-top:1px solid var(--line);padding:20px 0;margin-top:28px}
@media(max-width:1100px){.dashboard-grid{grid-template-columns:1fr}.hero h1{font-size:29px}}@media(max-width:760px){.layout{grid-template-columns:1fr}.sidebar{height:auto;position:static}.main{padding:20px}.case-message{font-size:19px}}
</style><link rel="stylesheet" href="/static/labs.css?v=90"></head><body>
<div class="layout"><aside class="sidebar"><div class="logo">◇ Graph<em>Shield</em></div><div class="muted tiny">LATE-DELIVERY REFUND DESK</div><div class="rail-label">DEMONSTRATE</div><nav class="nav">
<button class="active" data-jump="deskTop">01 &nbsp; Customer case</button>
<button data-jump="tracePanel">02 &nbsp; Agent trace</button>
<button data-jump="graphPanel">03 &nbsp; Tool decisions</button>
<button data-jump="modelPanel">04 &nbsp; Live AI agent</button>
<button data-jump="learningPanel">05 &nbsp; Learning evidence</button>
<button data-jump="benchPanel">06 &nbsp; Benchmarks</button>
<button data-jump="registryPanel">07 &nbsp; MCP infrastructure</button>
<button data-jump="diagPanel">08 &nbsp; Diagnostics</button>
<button data-jump="evidencePanel">09 &nbsp; Dataset & evidence</button>
</nav><div class="sidebar-hint">Order evidence: historical Olist data<br>Refund policies: demonstration simulation<br>Transactions: sandbox only</div><div class="side-footer">GRAPHSHIELD V9.3 · HYDRADB</div></aside>
<main class="main" id="deskTop"><div class="topbar"><div class="crumb">Customer operations / <strong>Multi-intent support desk</strong></div><div class="flex"><span class="build-tag" id="build">V9.3 · MULTI-INTENT CASES</span><span id="health" class="badge">● Checking database</span></div></div>
<div class="hero"><div class="eyebrow">FOUR SUPPORT INTENTS · CURATED WORKFLOWS · SHARED GRAPH</div><h1>Four customer-support scenarios. Every tool decision, visible.</h1><p class="intro">Inspect historical Olist orders across refund, payment, item, and status questions. Each scenario routes to its own HydraDB task and MCP workflow. Refund follow-up and outage simulations remain refund-only.</p>
<div class="sequence"><span>01 Investigate</span><span>02 Reuse context</span><span>03 Fail over</span><span>04 Compare AI</span></div><div class="hack-strip"><span>BUILT ON SELF-HOSTED HYDRADB · BOLT</span><span class="v">TRACK 2 · AGENT CONTEXT LAYER</span><span class="v">TRACK 1 · LEARNING EVIDENCE</span><span>READ-ONLY SANDBOX TOOLS</span></div></div>
<div class="case-card"><div class="case-kicker">Incoming support request</div><div class="case-message" id="deskCaseBanner">My order arrived 9 days late. I want a refund.</div>
<label class="tiny muted" for="deskRequest">CUSTOMER MESSAGE (EDITABLE)</label><input id="deskRequest" value="My order arrived 9 days late. I want a refund." style="width:100%;margin:6px 0 14px">
<label class="tiny muted" for="deskIntent">SUPPORT INTENT</label><select id="deskIntent" style="width:100%;margin:6px 0 12px"><option value="late_delivery_refund">Late-delivery refund · 38 cases</option><option value="payment_question">Payment inquiry · 38 cases</option><option value="wrong_item_inquiry">Wrong-item inquiry · 37 cases</option><option value="order_status">Order status · 37 cases</option></select><div class="flex"><select id="deskCase" class="grow"><option>Loading historical orders…</option></select><button id="deskLoadCases">Reload cases</button></div>
<div class="tiny muted" id="deskCaseNote">Awaiting order selection.</div>
<div class="flex" style="flex-wrap:wrap;margin-top:16px"><button id="deskRunFirst" class="primary">1 · Investigate this order</button><button id="deskRunFollow">2 · Ask follow-up</button><button id="deskSimOutage" class="danger">3 · Simulate primary outage</button><button id="deskRestore">Restore primary</button></div>
<div id="deskStatus" class="status">Ready for source-backed order investigation.</div></div>
<div class="dashboard-grid"><div>
<section id="tracePanel" class="panel"><div class="panel-head"><h2>Agent execution · Live trace</h2><span class="tiny muted">SSE events from actual tool calls</span></div><p class="small muted" style="margin-bottom:15px">Watch what HydraDB selected, each tool invocation, and the returned evidence. This button uses deterministic graph-guided orchestration; the LLM run is separate.</p><div id="deskTrace" class="desk-trace"><div class="empty">Select a case and click Investigate.</div></div></section>
<section id="modelPanel" class="panel"><div class="panel-head"><h2>Live AI agent · configured model provider</h2><span class="tiny muted">Three meta-tools</span></div><p class="small muted" style="margin-bottom:12px">graph_context → call_tool → report_outcome. The model’s calls and provider-reported usage appear here after a successful API request.</p><div id="deskLlmStatus" class="status">Checking live model configuration…</div><div class="flex"><select id="deskModelMode"><option value="graphshield">GraphShield context</option><option value="preload">All tools baseline</option></select><button id="deskRunModel" class="primary">Run real model</button></div><div id="deskModelTrace" class="desk-trace"><div class="empty">Select an order to begin a real model run.</div></div><details><summary>Provider usage and final answer</summary><pre id="deskModelResult">No model execution yet.</pre></details></section>
<section class="panel" id="learningPanel"><div class="lab-block" id="labLearning"><div class="panel-head"><h2>Continual-learning study · four systems</h2><span class="tag sim">Simulated fault injection</span></div><p class="small muted">Static router, lexical top-k, GraphShield cold and GraphShield learned run on identical held-out cases with historical order-linked cases and controlled injected outcomes (no LLM judge). Provider rewards are updated in HydraDB; the simulated outcomes are not production evidence. Only saved backend results are shown.</p><div class="flex wrap" style="margin:12px 0"><div class="seg" id="labMetricSeg"></div><button id="labLoadLearning" class="primary">Load study results</button></div><div id="labLearningOut" class="small muted">No study loaded.</div></div><hr style="border:0;border-top:1px solid var(--line);margin:22px 0"><div class="panel-head"><h2>Learning from provider outcomes</h2><span class="tiny muted">Controlled simulation · not production data</span></div><div class="flex"><select id="deskOnlineScenario"><option value="drift">Provider reliability changes</option><option value="stationary">Stable provider reliability</option></select><button id="deskLoadOnline">Load adaptation results</button></div><div id="deskOnline" class="small muted">No experiment report loaded.</div><hr style="border:0;border-top:1px solid var(--line);margin:20px 0"><div class="panel-head"><h2>Held-out study</h2><button id="deskLoadExperiment">Load 5-iteration study</button></div><div id="deskExperiment" class="small muted">No study loaded.</div></section>
</div><div>
<section id="graphPanel" class="panel"><h2>Why these tools?</h2><p class="small muted" style="margin:8px 0 14px">HydraDB dependency plan, selected provider, and rejected alternatives.</p><div id="deskGraph" class="desk-graph"><div class="empty">Run an investigation to see the selected path.</div></div><details><summary>Rejected alternatives and reasons</summary><pre id="deskRejected">No route resolved yet.</pre></details></section>
<section class="panel"><h2>Execution counters</h2><div id="deskKpis" class="small muted">No completed order investigation yet.</div></section>
<section class="panel"><h2 id="deskAssessmentTitle">Refund assessment (simulated policy)</h2><div id="deskAssessment" class="small muted">Run an investigation to inspect historical tool evidence.</div><p class="tiny muted" style="margin-top:12px">Refunds use invented rules; payment, wrong-item and status inquiries show historical records only. No real transactions or live tracking.</p></section>
<section class="panel" id="registryPanel"><h2>E-commerce MCP registry</h2><div id="deskRegistry" class="small muted">Loading discovered capabilities…</div><p class="tiny muted" style="margin-top:12px">Business roles: orders, customers, payments, logistics, policy, actions, plus unrelated-tool distractors. Provider instances are counted separately.</p></section>
</div></div>
<section id="evidencePanel" class="panel"><div class="panel-head"><h2>Reviewer evidence · MCP tools and dataset</h2><button id="reviewRefresh" class="primary">Refresh evidence</button></div>
<p class="small muted">These records come from the running backend. Discovery snapshots and simulation reports are labelled separately from live tool execution. If the backend cannot be reached, the panels show an error instead of invented counts.</p>
<div class="columns equal"><div><h3>MCP discovery registry</h3><div id="reviewMcpSummary" class="small muted">Not loaded</div><div class="search-box" style="margin:10px 0"><input id="reviewMcpSearch" placeholder="Filter by tool name or server" aria-label="Filter MCP tools"><button id="reviewMcpLoad">List all MCP tools</button></div><div class="table-wrap scroll"><table><thead><tr><th>Server</th><th>Tool</th><th>Source</th></tr></thead><tbody id="reviewMcpRows"><tr><td colspan="3">Load MCP tools to inspect discovery evidence.</td></tr></tbody></table></div><details><summary>Selected tool input schema</summary><pre id="reviewMcpSchema">Select a tool row.</pre></details></div>
<div><h3>Dataset provenance</h3><div id="reviewDataset" class="small muted" style="margin-top:12px">Not loaded</div><h3 style="margin-top:22px">Actual infrastructure check</h3><div id="reviewInfra" class="small muted" style="margin-top:12px">Not loaded</div><h3 style="margin-top:22px">Benchmark and learning availability</h3><div id="reviewStudies" class="small muted" style="margin-top:12px">Not checked</div><div class="flex" style="flex-wrap:wrap;margin-top:10px"><button id="reviewBenchJump" class="small outline">Open Benchmarks</button><button id="reviewLearningJump" class="small outline">Open Learning</button></div></div></div>
</section>
<section id="benchPanel" class="panel"><div class="panel-head"><h2>Benchmarks · dataflow edges and ablation</h2><button id="benchLoad" class="primary">Load benchmark results</button></div><p class="small muted">Candidate PRODUCES/CONSUMES relationships are inferred from tool schemas, not proven executable dependencies. The existing flat lexical-vs-graph comparison uses curated workflows and live HydraDB routing; it does not establish backward dataflow planning.</p><div id="benchOut" class="small muted" style="margin-top:12px">No benchmark loaded.</div></section>
<section id="diagPanel" class="panel"><div class="panel-head"><h2>Diagnostics · live HydraDB query shapes</h2><button id="diagRun" class="primary">Run diagnostics</button></div><p class="small muted">Executes every Cypher shape the app uses against the running HydraDB and reports pass or fail. Nothing is cached or faked.</p><div id="diagOut" class="small muted" style="margin-top:12px">Not run yet.</div><h3 style="margin-top:20px">Backend health</h3><div id="healthOut" class="small muted">Checking…</div><div class="danger-zone"><strong>Demo reset</strong><p class="small muted">Disabled: safe graph reset has not been implemented. Provider health can be restored using the narrower control in Customer Case.</p><button id="demoReset" disabled title="Safe graph reset is not implemented; disabled to protect stored evidence" class="danger">Reset demo</button></div></section>
<div class="footer-note">DATA: historical Olist orders · POLICY: invented demonstration rules · PROVIDER FAULTS: injected · ACTIONS: sandbox / approval required · TOKENS: labelled Measured or Estimated.</div>
</main></div><script src="/static/refund.js?v=93"></script><script src="/static/focused.js?v=82"></script><script src="/static/labs.js?v=90"></script><script src="/static/reviewer.js?v=92"></script></body></html>