GRAPH_BACKEND=hydradb
HYDRADB_BOLT=bolt://127.0.0.1:7687
HYDRADB_GRAPH=default
HYDRADB_TOKEN=REPLACE_WITH_YOUR_LOCAL_TOKEN
GRAPHSHIELD_CORS_ORIGINS=http://127.0.0.1:8800,http://localhost:8800
GRAPHSHIELD_RATE_LIMIT_PER_MIN=60
# Set this on public deployments to protect mutation endpoints:
GRAPHSHIELD_ADMIN_TOKEN=
# For optional real model usage; never commit secrets:
GRAPHSHIELD_LLM_API_KEY=
GRAPHSHIELD_LLM_MODEL=
GRAPHSHIELD_LLM_BASE_URL=https://api.groq.com/openai/v1
GRAPHSHIELD_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REPORTING_DOCUMENTS_DIR=C:\Users\Public\Documents\GraphShieldReports
